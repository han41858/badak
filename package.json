{
	"name": "badak",
	"version": "4.1.0",
	"description": "node.js Server framework based on Promise and TypeScript",
	"type": "commonjs",
	"exports": {
		".": {
			"import": {
				"types": "./build/esm/index.d.ts",
				"default": "./build/esm/index.js"
			},
			"require": {
				"types": "./build/cjs/index.d.ts",
				"default": "./build/cjs/index.js"
			}
		}
	},
	"types": "build/cjs/index.d.ts",
	"main": "build/cjs/index.js",
	"files": [
		"build",
		"src"
	],
	"scripts": {
		"prebuild": "rimraf ./build",
		"prepack": "yarn build",
		"build:cjs": "tsx ./scripts/create-package-json.ts cjs",
		"build:esm": "tsx ./scripts/create-package-json.ts esm",
		"build": "yarn build:cjs&&yarn build:esm",
		"test": "mocha",
		"test:types": "tsc --project tsconfig.types.json",
		"test:types:dist": "tsx ./scripts/check-dist-types.ts",
		"lint": "eslint src spec sample"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/han41858/badak.git"
	},
	"keywords": [
		"server",
		"framework",
		"promise",
		"async",
		"await",
		"typescript"
	],
	"author": "han41858@gmail.com",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/han41858/badak/issues"
	},
	"homepage": "https://github.com/han41858/badak#readme",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "^26.1.0",
		"@types/supertest": "^7.2.0",
		"chai": "^6.2.2",
		"eslint": "^10.6.0",
		"eslint-plugin-chai-friendly": "^1.2.1",
		"globals": "^17.7.0",
		"mocha": "^12.0.3",
		"rimraf": "^6.1.3",
		"supertest": "^7.2.2",
		"tsx": "^4.23.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1"
	}
}
